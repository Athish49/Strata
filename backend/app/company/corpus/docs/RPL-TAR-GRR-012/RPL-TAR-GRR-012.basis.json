  "interpretations": [
    {
      "id": "INT-001",
      "rule": "R13.6",
      "text": "170 IAC 4-1-16.6 winter moratorium covers both actual LIHEAP recipients and those who are eligible and have applied; Rule 13.6 captures both categories expressly."
    },
    {
      "id": "INT-002",
      "rule": "R12.5",
      "text": "Rule 12.5 integrates the billing adjustment for utility error (170 IAC 4-1-14) with the disconnection prohibition for large bills due to utility error (170 IAC 4-1-16(c)(3)), as these provisions operate together in practice."
    }
  ],
