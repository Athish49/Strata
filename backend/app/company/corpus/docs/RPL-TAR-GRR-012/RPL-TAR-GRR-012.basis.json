  "value_ledger": [
    {
      "id": "VL-001",
      "rule": "R11.2",
      "topic": "Bill delinquency period",
      "value": "17 days after postmark",
      "citation": "170 IAC 4-1-13(c)"
    },
    {
      "id": "VL-002",
      "rule": "R11.3",
      "topic": "Late payment charge maximum",
      "value": "10% of first $3 plus 3% of excess of $3",
      "citation": "170 IAC 4-1-13(c)"
    },
    {
      "id": "VL-003",
      "rule": "R10.3",
      "topic": "New applicant deposit maximum",
      "value": "1/6 of estimated annual cost of service",
      "citation": "170 IAC 4-1-15(c)"
    },
    {
      "id": "VL-004",
      "rule": "R10.3",
      "topic": "Deposit installment threshold",
      "value": "$70",
      "citation": "170 IAC 4-1-15(c)"
    },
    {
      "id": "VL-005",
      "rule": "R10.3",
      "topic": "Deposit installment period (new applicant)",
      "value": "no less than 8 weeks",
      "citation": "170 IAC 4-1-15(c)"
    },
    {
      "id": "VL-006",
      "rule": "R10.5",
      "topic": "Existing customer deposit maximum",
      "value": "1/6 of expected annual billings",
      "citation": "170 IAC 4-1-15(e)"
    },
    {
      "id": "VL-007",
      "rule": "R10.5",
      "topic": "Existing customer deposit installment window",
      "value": "2 monthly billing cycles (approximately 60 days) for deposits >$70",
      "citation": "170 IAC 4-1-15(e)"
    },
    {
      "id": "VL-008",
      "rule": "R10.6",
      "topic": "Deposit interest rate",
      "value": "6% per annum for deposits held more than 12 months",
      "citation": "170 IAC 4-1-15(f)(1)"
    },
    {
      "id": "VL-009",
      "rule": "R10.7",
      "topic": "Deposit refund \u2014 satisfactory payment period",
      "value": "9 successive months OR 10 out of 12 consecutive months without late payment in 2 consecutive months",
      "citation": "170 IAC 4-1-15(g)(1)"
    },
    {
      "id": "VL-010",
      "rule": "R10.7",
      "topic": "Deposit refund after termination",
      "value": "Within 15 days after payment of final bill",
      "citation": "170 IAC 4-1-15(g)(3)(b)"
    },
    {
      "id": "VL-011",
      "rule": "R13.3",
      "topic": "Residential disconnection notice period",
      "value": "14 days prior written notice",
      "citation": "170 IAC 4-1-16(e)"
    },
    {
      "id": "VL-012",
      "rule": "R13.4",
      "topic": "Disconnection hours",
      "value": "8:00 a.m. to 3:00 p.m. prevailing local time",
      "citation": "170 IAC 4-1-16(d)"
    },
    {
      "id": "VL-013",
      "rule": "R13.6",
      "topic": "LIHEAP winter moratorium period",
      "value": "December 1 through March 15",
      "citation": "170 IAC 4-1-16.6(a)"
    },
    {
      "id": "VL-014",
      "rule": "R13.7",
      "topic": "Medical postponement of disconnection",
      "value": "10 days, extendable one additional 10-day period",
      "citation": "170 IAC 4-1-16(c)"
    },
    {
      "id": "VL-015",
      "rule": "R13.5",
      "topic": "Hardship plan minimum payment",
      "value": "Not to exceed $10 or 1/10 of bill, whichever is less",
      "citation": "170 IAC 4-1-16(c)(2)(A)"
    },
    {
      "id": "VL-016",
      "rule": "R13.5",
      "topic": "Hardship plan payment period",
      "value": "3 months",
      "citation": "170 IAC 4-1-16(c)(2)(B)"
    },
    {
      "id": "VL-017",
      "rule": "R13.9",
      "topic": "Reconnection time after conditions satisfied",
      "value": "1 working day",
      "citation": "170 IAC 4-1-16(g)"
    },
    {
      "id": "VL-018",
      "rule": "R09.4",
      "topic": "Watthour meter average accuracy tolerance",
      "value": "Average error not over 2%, plus or minus",
      "citation": "170 IAC 4-1-9(b)(1)(A)"
    },
    {
      "id": "VL-019",
      "rule": "R09.4",
      "topic": "Watthour meter full load tolerance",
      "value": "Error at full load not over 1%, plus or minus",
      "citation": "170 IAC 4-1-9(b)(1)(B)"
    },
    {
      "id": "VL-020",
      "rule": "R09.4",
      "topic": "Watthour meter light load tolerance",
      "value": "Error at light load not over 3%, plus or minus",
      "citation": "170 IAC 4-1-9(b)(1)(C)"
    },
    {
      "id": "VL-021",
      "rule": "R09.6",
      "topic": "Periodic meter test interval",
      "value": "Not more than 16 years",
      "citation": "170 IAC 4-1-10(b)"
    },
    {
      "id": "VL-022",
      "rule": "R09.7",
      "topic": "Written meter test report delivery",
      "value": "Within 10 days after test is complete",
      "citation": "170 IAC 4-1-11(d)"
    },
    {
      "id": "VL-023",
      "rule": "R09.7",
      "topic": "Meter test appeal filing period",
      "value": "5 days from date of written report",
      "citation": "170 IAC 4-1-11(e)"
    },
    {
      "id": "VL-024",
      "rule": "R12.2",
      "topic": "Fast meter billing adjustment period",
      "value": "Period meter was fast or 1 year, whichever is shorter",
      "citation": "170 IAC 4-1-14(A)(1)"
    },
    {
      "id": "VL-025",
      "rule": "R12.3",
      "topic": "Slow/stopped meter back-billing period",
      "value": "1/2 of period since last test or 1 year, whichever is shorter",
      "citation": "170 IAC 4-1-14(A)(2)"
    },
    {
      "id": "VL-026",
      "rule": "R12.4",
      "topic": "Other billing error adjustment period",
      "value": "Known date of error or 1 year, whichever is shorter",
      "citation": "170 IAC 4-1-14(B)"
    },
    {
      "id": "VL-027",
      "rule": "R12.1",
      "topic": "Billing adjustment error threshold \u2014 watthour",
      "value": ">3% error",
      "citation": "170 IAC 4-1-14(A)"
    },
    {
      "id": "VL-028",
      "rule": "R12.1",
      "topic": "Billing adjustment error threshold \u2014 demand",
      "value": ">4% error",
      "citation": "170 IAC 4-1-14(A)"
    },
    {
      "id": "VL-029",
      "rule": "R06.1",
      "topic": "Standard frequency",
      "value": "60 Hz nominal",
      "citation": "170 IAC 4-1-19"
    },
    {
      "id": "VL-030",
      "rule": "R06.3",
      "topic": "Residential voltage tolerance",
      "value": "+/- 5% of nominal; total variation \u22646% in cities >2,500 pop, \u22648% elsewhere",
      "citation": "170 IAC 4-1-20(A)(1)"
    },
    {
      "id": "VL-031",
      "rule": "R13.10",
      "topic": "Customer appeal period to Consumer Affairs",
      "value": "7 days from receipt of utility's proposed resolution",
      "citation": "170 IAC 16-1-4(c)(5)"
    },
    {
      "id": "VL-032",
      "rule": "R13.10",
      "topic": "Consumer Affairs decision period",
      "value": "30 days from complaint submission",
      "citation": "170 IAC 16-1-5(c)(5)"
    },
    {
      "id": "VL-033",
      "rule": "R13.10",
      "topic": "Commission review request period",
      "value": "20 days from Consumer Affairs director decision",
      "citation": "170 IAC 16-1-6(a)"
    },
    {
      "id": "VL-034",
      "rule": "R13.11",
      "topic": "Disconnect moratorium during dispute",
      "value": "No disconnect while under review; or sooner than 10 days after decision",
      "citation": "170 IAC 16-1-7(a)"
    },
    {
      "id": "VL-035",
      "rule": "R13.11",
      "topic": "Undisputed amount for dispute protection",
      "value": "1/12 of estimated annual billing",
      "citation": "170 IAC 16-1-7(b)"
    },
    {
      "id": "VL-036",
      "rule": "R03.1",
      "topic": "Records retention minimum",
      "value": "3 years",
      "citation": "170 IAC 4-1-3"
    },
    {
      "id": "VL-037",
      "rule": "R03.5",
      "topic": "Dispute records retention",
      "value": "6 months from date of final resolution",
      "citation": "170 IAC 16-1-4(b)"
    },
    {
      "id": "VL-038",
      "rule": "R14.5",
      "topic": "Reliability data retention",
      "value": "Minimum 7 years",
      "citation": "170 IAC 4-1-23(f)"
    },
    {
      "id": "VL-039",
      "rule": "R13.5",
      "topic": "Prior-location unpaid bill prohibition period",
      "value": "Less than 45 days unpaid",
      "citation": "170 IAC 4-1-16(c)(1)(B)"
    },
    {
      "id": "VL-040",
      "rule": "R13.8",
      "topic": "Pre-disconnection employee record retention",
      "value": "At least 30 days",
      "citation": "170 IAC 4-1-16(f)(3)"
    },
    {
      "id": "VL-041",
      "rule": "R10.2",
      "topic": "Prior utility customer lookback for creditworthiness",
      "value": "2 years",
      "citation": "170 IAC 4-1-15(b)(1)"
    },
    {
      "id": "VL-042",
      "rule": "R10.2",
      "topic": "Outstanding bill lookback for creditworthiness",
      "value": "4 years",
      "citation": "170 IAC 4-1-15(b)(1)(A)"
    },
    {
      "id": "VL-043",
      "rule": "R09.3",
      "topic": "New meter installation test window",
      "value": "Within 60 days of installation",
      "citation": "170 IAC 4-1-6(c)"
    },
    {
      "id": "VL-044",
      "rule": "R09.10",
      "topic": "Reference standard calibration interval",
      "value": "At least once every 2 years",
      "citation": "170 IAC 4-1-7(C)"
    },
    {
      "id": "VL-045",
      "rule": "R13.1",
      "topic": "Customer disconnection notice advance",
      "value": "At least 3 days in advance",
      "citation": "170 IAC 4-1-16(a)(1)"
    }
