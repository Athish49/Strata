  "company_practice_items": [
    "RRS-CS-002: 7 years after closure (exceeds 3-year IURC minimum)",
    "RRS-CS-004: 3 years for IURC-escalated complaints (exceeds 6-month minimum per 170 IAC 16-1-4)",
    "RRS-CS-006: Life of account + 7 years (no specific IURC retention rule for service agreements)",
    "RRS-DO-003: Permanent for GIS/system maps (operational necessity)",
    "RRS-DO-004: 7 years for work orders (aligns with FERC plant records)",
    "RRS-DO-008: 3 years for underground locate records",
    "RRS-DO-009: 10 years for substation maintenance records",
    "RRS-DO-010: 7 years for DCC logs",
    "RRS-FIN-001: 10 years for general ledger (exceeds FERC minimum)",
    "RRS-FIN-005: 7 years for tax returns (covers longest SOL)",
    "RRS-FIN-008: 7 years for bank records",
    "RRS-FIN-009: 7 years for accounts payable",
    "RRS-GEN-007: 7 years for cybersecurity incident records (IC 24-4.9 breach law)"
  ],
  "interpretations": [
    {
      "issue": "170 IAC 4-1-3 vs. longer specific periods",
      "resolution": "Applied dual-requirement rule (Section 5.3): longer of applicable periods governs; 3-year minimum is a floor, not a cap"
    },
    {
      "issue": "170 IAC 16-1-4(b) 6-month dispute record minimum",
      "resolution": "6-month minimum applied for routine utility-level disputes (RRS-CS-003); company practice extended to 3 years for IURC-escalated matters (RRS-CS-004)"
    },
    {
      "issue": "170 IAC 4-1-4(b) permanent meter records",
      "resolution": "Interpreted as covering both active and retired meters; RRS-MTR-001 and RRS-MTR-008 designated permanent"
    }
  ],
