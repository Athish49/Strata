  "interpretations": [
    {
      "id": "INT-001",
      "regulation": "170 IAC 4-1-23(b)(1)(A)",
      "question": "What is the effective customer threshold for RPL as an IOU?",
      "answer": "5,000 customers. Rule: lesser of (2% of customers served) or 5,000. 2% of 407,491 = 8,149. min(8149, 5000) = 5,000.",
      "impact": "\u00a77.2 decision table, \u00a718.2 reportable incident determination"
    },
    {
      "id": "INT-002",
      "regulation": "170 IAC 4-1-23(b)(1)(A)",
      "question": "Does both the duration (2 hours) AND customer (5,000) criterion need to be met for reportability?",
      "answer": "Yes. The rule uses 'and' \u2014 both must be met simultaneously. A 3-hour outage affecting 4,000 customers is not reportable. A 1-hour outage affecting 6,000 customers is not reportable.",
      "impact": "\u00a77.2 decision table; INC-2024-00003 excluded (peak 3,529 < 5,000)"
    },
    {
      "id": "INT-003",
      "regulation": "170 IAC 4-1-23(a)(10)",
      "question": "Can RPL define its own momentary threshold?",
      "answer": "Yes. The regulation allows utilities to define their own threshold of 5 minutes or less. RPL applies the default statutory 5-minute threshold.",
      "impact": "\u00a73.6, \u00a73.7"
    },
    {
      "id": "INT-004",
      "regulation": "170 IAC 4-1-23(e)",
      "question": "What is the annual report filing deadline?",
      "answer": "On or before March 1 of each year. The report must include SAIDI, CAIDI, SAIFI with and without major events; definition of major event; and number of customers used.",
