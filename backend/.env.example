# Strata backend — environment variables
# Copy to .env and fill in real values

# Neon PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# Qdrant
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_PROJECT_TAG=strata

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name

# Web app origin allowed to call this API (CORS). Prod: your deployed frontend URL.
FRONTEND_URL=http://localhost:3000

# Company ingest
CORPUS_ROOT=/path/to/backend/app/company/corpus
COMPANY_ID=rpl
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=your-anthropic-api-key
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_DIM=384

# Impact engine (all optional; defaults shown)
# ENGINE_COMPANY_ID=rpl
# ENGINE_CHARACTERIZE_MODEL=claude-sonnet-5-5
# ENGINE_JUDGE_MODEL=claude-sonnet-5-5
# ENGINE_RADAR_MODEL=claude-haiku-4-5-20251001
# ENGINE_MIN_CONFIDENCE=0.6
# ENGINE_RENUMBER_JACCARD=0.80
# ENGINE_JUDGE_MAX_SECTION_CHARS=8000
# ENGINE_JUDGE_WINDOW_CHARS=1500
# ENGINE_MAX_LLM_CALLS_KB=900
# ENGINE_MAX_LLM_CALLS_WHATIF=300
# ENGINE_LLM_CONCURRENCY=8
# ENGINE_RADAR_CONCURRENCY=16
