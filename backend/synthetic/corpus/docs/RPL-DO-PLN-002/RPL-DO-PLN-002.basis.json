  "company_practice_items": [
    {
      "clause_id": "RPL-DO-PLN-002:7.3",
      "item": "RPL Clearance Specification Table",
      "description": "Minimum clear distances (ft) by voltage class, trim direction, and species growth class. Locality factors may increase target clearance by up to 3 ft per crew foreman judgment."
    },
    {
      "clause_id": "RPL-DO-PLN-002:8.1",
      "item": "Trim Cycle Assignments",
      "description": "Backbone circuits: 4-year cycle; single-phase lateral circuits: 5-year cycle; urban/UG-dominant circuits: 6-year cycle; 69 kV subtransmission ROW: 5-year floor management cycle."
    },
    {
      "clause_id": "RPL-DO-PLN-002:9.3",
      "item": "Hours of Work",
      "description": "Routine cycle trimming performed 07:00–18:00 local time, Monday through Friday. Saturday requires P22 advance approval."
    },
    {
      "clause_id": "RPL-DO-PLN-002:11.3",
      "item": "Notice Sequence",
      "description": "Internal standard of 21 calendar days for VM-F-004 letter mailing (vs. regulatory minimum 14 days); door hanger 3 calendar days before work start; day-of phone call for customers who requested estimated day."
    },
    {
      "clause_id": "RPL-DO-PLN-002:13.3",
      "item": "Stump Treatment Standard",
      "description": "Stumps ground to at least 4 inches below grade; depression backfilled with topsoil. Chemical stump treatment alternative where mechanical grinding impractical."
    },
    {
      "clause_id": "RPL-DO-PLN-002:14.2",
      "item": "Hazard Tree Risk Tiers and Response Targets",
      "description": "Tier 1 (Imminent): remove/make safe within 24 hours. Tier 2 (High): dispatch within 5 business days, complete removal within 30 calendar days. Tier 3 (Moderate): next scheduled cycle or mid-cycle program."
    },
    {
      "clause_id": "RPL-DO-PLN-002:15.2",
      "item": "IVM Herbicide Application",
      "description": "Only EPA-registered products applied by licensed pesticide applicators. No product names in plan; approved-product list maintained by P22 and updated annually."
    },
    {
      "clause_id": "RPL-DO-PLN-002:15.3",
      "item": "IVM Sensitive Area Exclusions",
      "description": "Herbicide application prohibited within 25 feet of open water, sinkholes, karst features, private wells, organic farming operations, and school or playground property."
    },
    {
      "clause_id": "RPL-DO-PLN-002:15.4",
      "item": "IVM Efficacy Audits",
      "description": "IVM treatment results reviewed at 6-month and 24-month post-treatment intervals using OMS tree CI on treated circuits vs. pre-treatment baseline."
    },
    {
      "clause_id": "RPL-DO-PLN-002:18.2",
      "item": "69 kV ROW Width Standards",
      "description": "Agricultural/open: 40 ft each side of centerline; wooded corridor: 60 ft; within 100 ft of substation: 75 ft."
    },
    {
      "clause_id": "RPL-DO-PLN-002:18.3",
      "item": "69 kV ROW Inspection Cycle",
      "description": "Annual foot or helicopter inspection. Floor management cycle: 5 years for corridor interior with annual spot treatment. Work scheduled Q2–Q3 with Contractor B."
    },
    {
      "clause_id": "RPL-DO-PLN-002:19.2",
      "item": "Crew Audit Rate",
      "description": "5% of all WAM work orders per quarter audited by P22 or designated RPL Forester."
    },
    {
      "clause_id": "RPL-DO-PLN-002:19.3",
      "item": "Post-Work Audit Sample",
      "description": "Minimum 5% random sample of completed circuits within 30 calendar days of circuit completion. Pass criteria: >=90% of trim points within 10% of target clearance; zero debris or ID violations."
    },
    {
      "clause_id": "RPL-DO-PLN-002:T19",
      "item": "Contractor KPI Targets",
      "description": "Post-work audit pass rate >=90%; debris compliance rate >=98%; crew ID compliance 100%; notice lead compliance 100%; completed miles vs. plan >=95%."
    },
    {
      "clause_id": "RPL-DO-PLN-002:T24",
      "item": "2025 Budget — Total and Line Items",
      "description": "Total $41,600,000. Lines: routine cycle $27,940,000; hazard tree $6,180,000; IVM $2,580,000; mid-cycle $2,020,000; storm/emergency $1,490,000; 69 kV ROW $910,000; oversight/QA $390,000; customer education $90,000."
    },
    {
      "clause_id": "RPL-DO-PLN-002:2.3",
      "item": "Customer Contact Closure Targets",
      "description": "Respond within 1 business day; close 90% of contacts within 10 calendar days; fewer than 30 formal dispute escalations per year."
    }
  ],
