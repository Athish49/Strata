# Backend origin the browser calls. Local: http://localhost:8000. Production: set in the host dashboard
# (https://strata-trqv.onrender.com). Trailing slash optional. Baked in at build time: restart/rebuild after changing.
BACKEND_URL=http://localhost:8000
# Custom what-if runs write to the DB and spend LLM budget; blocked unless set to 1 (keep unset for the demo)
# NEXT_PUBLIC_STRATA_ALLOW_CUSTOM_WHATIF=1
