# Local secrets
**/.env

# Python bytecode and venv
**/__pycache__/
**/*.py[cod]
**/.venv/

# macOS
**/.DS_Store

# Playwright MCP dumps
**/.playwright-mcp/

# Dependencies and build output (any depth)
**/node_modules/
**/.next/
**/.next-*/

# Test output and caches
**/test-results/
**/playwright-report/
**/.pytest_cache/

# Logs
**/*.log
